@model Project2Email.Dtos.UserRegisterDto
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" class="dark-style">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Ol - Project2Email</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #696cff;
            --bg-body: #232333;
            --bg-paper: rgba(43, 44, 64, 0.75);
            --text-primary: #dbdbeb;
            --text-secondary: #a3a4cc;
            --border-color: #444564;
            --input-bg: rgba(35, 35, 51, 0.8);
        }

        body {
            font-family: 'Public Sans', sans-serif;
            background-color: var(--bg-body);
            color: var(--text-primary);
            height: 100vh;
            margin: 0;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        #canvas-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            background: linear-gradient(to bottom, #1a1a2e, #16213e);
        }

        .authentication-wrapper {
            display: flex;
            flex-basis: 100%;
            min-height: 100vh;
            width: 100%;
            z-index: 1;
            align-items: center;
            justify-content: center;
        }

        .authentication-inner {
            width: 100%;
            max-width: 450px;
            padding: 1rem;
        }

        .card {
            background-color: var(--bg-paper);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.5rem;
            box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.5);
        }

        .card-body {
            padding: 2rem;
        }

        .app-brand {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-bottom: 1.5rem;
            gap: 10px;
        }

        .app-brand-text {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: -0.5px;
        }

        .app-brand-logo i {
            font-size: 2rem;
            color: var(--primary-color);
        }

        h4 {
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        p {
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .form-label {
            color: var(--text-primary);
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 0.4rem;
        }

        .form-control {
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-primary);
            padding: 0.6rem 1rem;
            font-size: 0.95rem;
        }

            .form-control:focus {
                background-color: var(--input-bg);
                border-color: var(--primary-color);
                color: var(--text-primary);
                box-shadow: 0 0 0 0.25rem rgba(105, 108, 255, 0.2);
            }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            padding: 0.7rem;
            font-weight: 600;
            box-shadow: 0 0.125rem 0.25rem 0 rgba(105, 108, 255, 0.4);
            width: 100%;
            margin-top: 10px;
        }

            .btn-primary:hover {
                background-color: #5f61e6;
                border-color: #5f61e6;
                transform: translateY(-1px);
            }

        a {
            color: var(--primary-color);
            text-decoration: none;
            font-size: 0.9rem;
        }

            a:hover {
                color: #8c8eff;
            }

        .text-danger {
            font-size: 0.85rem;
            margin-top: 0.5rem;
        }

        /* Modal Styles Overlay for Dark Theme */
        .modal-content {
            background-color: #2b2c40 !important;
            border: 1px solid var(--border-color);
            color: var(--text-primary);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-color);
        }

        .modal-footer {
            border-top: 1px solid var(--border-color);
        }

        .btn-close {
            filter: invert(1);
        }
    </style>
</head>
<body>

    <div id="canvas-container"></div>

    <div class="authentication-wrapper">
        <div class="authentication-inner">
            <div class="card">
                <div class="card-body">

                    <div class="app-brand">
                        <span class="app-brand-logo">
                            <i class='bx bxl-gmail'></i>
                        </span>
                        <span class="app-brand-text">Project2Email</span>
                    </div>

                    <h4 class="mb-2">Maceraya Başla 🚀</h4>
                    <p class="mb-4">E-posta yönetiminizi yapay zeka ile güçlendirin.</p>

                    <form method="post">

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label">Adınız</label>
                                <input type="text" asp-for="Name" class="form-control" placeholder="Ad" autofocus />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Soyadınız</label>
                                <input type="text" asp-for="Surname" class="form-control" placeholder="Soyad" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı</label>
                            <input type="text" asp-for="Username" class="form-control" placeholder="Kullanıcı adı seçin" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email Adresi</label>
                            <input type="email" asp-for="Email" class="form-control" placeholder="ornek@email.com" />
                        </div>

                        <div class="mb-3 form-password-toggle">
                            <label class="form-label">Şifre</label>
                            <input type="password" asp-for="Password" class="form-control" placeholder="&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;&#xb7;" />
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="terms-conditions" asp-for="IReadAgreeStatus">
                                <label class="form-check-label" for="terms-conditions" style="color:var(--text-secondary); font-size:0.85rem;">
                                    <a href="javascript:void(0);" data-bs-toggle="modal" data-bs-target="#termsModal">Gizlilik Politikası</a>'nı okudum ve kabul ediyorum.
                                </label>
                            </div>
                        </div>

                        <div class="text-danger mb-3" asp-validation-summary="ModelOnly"></div>

                        <button class="btn btn-primary d-grid w-100">Kayıt Ol</button>
                    </form>

                    <p class="text-center mt-4">
                        <span>Zaten hesabınız var mı?</span>
                        <a href="/Login/UserLogin">Giriş Yap</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="termsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" style="color: var(--text-primary);">Kullanım Koşulları ve Gizlilik</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body" style="color: var(--text-secondary); font-size: 0.9rem;">
                    <p><strong>1. Veri Toplama:</strong> Hizmetlerimizi kullanırken sağladığınız kişisel veriler (ad, e-posta vb.) güvenli bir şekilde saklanmaktadır.</p>
                    <p><strong>2. Kullanım Amacı:</strong> Verileriniz, size daha iyi hizmet sunmak ve hesap güvenliğini sağlamak amacıyla işlenir.</p>
                    <p><strong>3. Üçüncü Taraflar:</strong> Yasal zorunluluklar dışında verileriniz üçüncü taraflarla paylaşılmaz.</p>
                    <p><strong>4. Güvenlik:</strong> Verilerinizin güvenliği için endüstri standardı şifreleme yöntemleri kullanılmaktadır.</p>
                    <p><strong>5. Değişiklikler:</strong> Bu politika üzerinde değişiklik yapma hakkımız saklıdır.</p>
                    <hr style="border-color: var(--border-color);">
                    <p>Lütfen devam etmek için bu koşulları kabul ediniz.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" onclick="rejectTerms()">Vazgeç</button>
                    <button type="button" class="btn btn-primary" onclick="acceptTerms()">Okudum, Kabul Ediyorum</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/loaders/FontLoader.js"></script>
    <script src="https://unpkg.com/three@0.128.0/examples/js/geometries/TextGeometry.js"></script>

    <script>
        // Modal Logic
        const termsModalEl = document.getElementById('termsModal');
        const termsModal = new bootstrap.Modal(termsModalEl);

        function acceptTerms() {
            var checkbox = document.getElementById('terms-conditions');
            checkbox.checked = true;
            termsModal.hide();
        }

        function rejectTerms() {
            var checkbox = document.getElementById('terms-conditions');
            checkbox.checked = false;
        }

        // Three.js Logic
        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 40;

        const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        document.getElementById('canvas-container').appendChild(renderer.domElement);

        let mouseX = 0;
        let mouseY = 0;
        let targetX = 0;
        let targetY = 0;

        const windowHalfX = window.innerWidth / 2;
        const windowHalfY = window.innerHeight / 2;

        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX - windowHalfX);
            mouseY = (event.clientY - windowHalfY);
        });

        const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambientLight);

        const pointLight = new THREE.PointLight(0x696cff, 1);
        pointLight.position.set(20, 20, 20);
        scene.add(pointLight);

        const pointLight2 = new THREE.PointLight(0xff3e1d, 1);
        pointLight2.position.set(-20, -20, 20);
        scene.add(pointLight2);

        const group = new THREE.Group();
        scene.add(group);

        const loader = new THREE.FontLoader();

        loader.load('https://threejs.org/examples/fonts/helvetiker_bold.typeface.json', function (font) {

            const textGeo = new THREE.TextGeometry('MAIL', {
                font: font,
                size: 15,
                height: 2,
                curveSegments: 12,
                bevelEnabled: true,
                bevelThickness: 0.5,
                bevelSize: 0.3,
                bevelOffset: 0,
                bevelSegments: 5
            });

            textGeo.computeBoundingBox();
            const centerOffset = - 0.5 * ( textGeo.boundingBox.max.x - textGeo.boundingBox.min.x );
            textGeo.translate( centerOffset, 0, 0 );

            const material = new THREE.MeshNormalMaterial({
                wireframe: false,
                flatShading: false
            });

            const textMesh = new THREE.Mesh(textGeo, material);
            textMesh.scale.set(1.8, 1, 1);
            group.add(textMesh);
        });

        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 700;
        const posArray = new Float32Array(particlesCount * 3);

        for(let i = 0; i < particlesCount * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 150;
        }

        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        const particlesMaterial = new THREE.PointsMaterial({
            size: 0.25,
            color: 0x696cff,
            transparent: true,
            opacity: 0.8
        });
        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);

        const clock = new THREE.Clock();

        function animate() {
            targetX = mouseX * 0.0008;
            targetY = mouseY * 0.0008;

            const elapsedTime = clock.getElapsedTime();

            if (group) {
                group.rotation.y += 0.05 * (targetX - group.rotation.y);
                group.rotation.x += 0.05 * (targetY - group.rotation.x);
                group.position.y = Math.sin(elapsedTime * 0.5) * 1;
            }

            particlesMesh.rotation.y = elapsedTime * 0.05;
            particlesMesh.rotation.x = mouseY * 0.0001;

            renderer.render(scene, camera);
            requestAnimationFrame(animate);
        }

        animate();

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>

</body>
</html>