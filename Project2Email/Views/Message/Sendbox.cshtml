@model List<Project2Email.Dtos.InboxMessageDto>

@{
    ViewData["Title"] = "Gönderilen Kutusu";
    Layout = "~/Views/Layout/Index.cshtml";
}

<style>
    /* Temel Değişkenler ve CSS (Index ile aynı) */
    :root {
        --bg-paper: #2b2c40;
        --border-color: #444564;
        --text-primary: #dbdbeb;
        --text-secondary: #a3a4cc;
        --hover-bg: rgba(68, 69, 100, 0.5);
    }

    .email-card {
        background: var(--bg-paper);
        border-radius: 0.5rem;
        height: 100%;
        display: flex;
        flex-direction: column;
        border: 1px solid var(--border-color);
        min-height: 80vh;
    }

    .email-toolbar {
        padding: 0.8rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background-color: rgba(35, 35, 51, 0.3);
    }

    .email-list-container {
        flex-grow: 1;
        overflow-y: auto;
    }

    .email-list-item {
        display: flex;
        align-items: center;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        transition: 0.2s;
        color: var(--text-primary);
        text-decoration: none;
    }

        .email-list-item:hover {
            background-color: var(--hover-bg);
            color: #fff;
        }

    .email-content {
        flex-grow: 1;
        display: flex;
        align-items: center;
        overflow: hidden;
        white-space: nowrap;
        margin-left: 1rem;
    }

    .email-subject {
        color: #fff;
        margin-right: 0.5rem;
        font-weight: 600;
    }

    .email-snippet {
        color: var(--text-secondary);
        font-size: 0.9rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .email-meta {
        text-align: right;
        min-width: 200px;
        margin-left: 1rem;
    }

    .sender-name {
        font-weight: 600;
        font-size: 0.85rem;
        color: var(--text-primary);
        display: block;
    }

    .email-date {
        font-size: 0.75rem;
        color: #6f7194;
    }

    .icon-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 1.25rem;
        cursor: pointer;
    }
</style>

<div class="email-card">

    <div class="email-toolbar">
        <div class="d-flex align-items-center gap-2">
            <button class="icon-btn" title="Yenile" onclick="location.reload()">
                <i class='bx bx-refresh'></i>
            </button>
            <span class="ms-3 fw-semibold text-white">Gönderilen Kutusu</span>
        </div>
        <div class="text-muted small">
            <span style="color: var(--text-secondary);">@Model.Count Mesaj</span>
        </div>
    </div>

    <div class="email-list-container">
        @if (Model.Count > 0)
        {
            @foreach (var item in Model)
            {
                <a href="/Message/Detail/@item.MessageId" class="email-list-item">

                    <i class='bx bx-check-double text-success' style="font-size: 1.2rem;"></i>

                    <div class="email-content">
                        <span class="email-subject">@item.Subject</span>
                        <span class="email-snippet"> - @item.Summary</span>
                    </div>

                    <div class="email-meta">
                        <span class="sender-name">
                            Alıcı: @item.ReceiverEmail
                        </span>
                        <span class="email-date">@item.SendDate.ToString("dd MMM HH:mm")</span>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class='bx bx-send text-secondary' style="font-size: 4rem;"></i>
                <p class="mt-3 text-secondary">Henüz mesaj göndermediniz.</p>
            </div>
        }
    </div>
</div>